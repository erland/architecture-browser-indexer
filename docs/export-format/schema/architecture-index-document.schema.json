{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-browser.example/schema/architecture-index-document.schema.json",
  "title": "Architecture Index Document",
  "description": "Top-level structural schema for the Architecture Browser export format. This schema intentionally validates the stable core contract while leaving enriched metadata extensible.",
  "type": "object",
  "required": [
    "schemaVersion",
    "indexerVersion",
    "runMetadata",
    "source",
    "scopes",
    "entities",
    "relationships",
    "diagnostics",
    "completeness",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Export format schema version. Consumers should treat this as the primary compatibility boundary."
    },
    "indexerVersion": {
      "type": "string",
      "description": "Indexer build/version string for operational traceability."
    },
    "runMetadata": {
      "$ref": "./runMetadata.schema.json"
    },
    "source": {
      "$ref": "./source.schema.json"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "./scope.schema.json"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "./entity.schema.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "./relationship.schema.json"
      }
    },
    "viewpoints": {
      "type": "array",
      "description": "Optional document-level canonical viewpoint catalog.",
      "items": {
        "$ref": "./viewpoint.schema.json"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./diagnostic.schema.json"
      }
    },
    "completeness": {
      "$ref": "./completeness.schema.json"
    },
    "metadata": {
      "type": "object",
      "description": "Document-level enriched metadata. The schema intentionally leaves this extensible.",
      "default": {},
      "additionalProperties": true,
      "properties": {
        "dependencyViews": {
          "type": "object",
          "description": "Optional dependency-view catalog keyed by view id.",
          "additionalProperties": true
        },
        "summary": {
          "type": "object",
          "description": "Optional summary and overview metadata.",
          "additionalProperties": true
        }
      }
    },
    "dependencyViews": {
      "type": "object",
      "description": "Optional dependency-view catalog keyed by view id. Duplicated at top level for platform/browser import compatibility; may also be mirrored under metadata.dependencyViews.",
      "additionalProperties": true
    }
  }
}