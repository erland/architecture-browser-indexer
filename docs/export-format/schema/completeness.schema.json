{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./completeness.schema.json",
  "title": "Completeness",
  "description": "Completeness object for architecture export.",
  "type": "object",
  "required": [
    "status",
    "indexedFileCount",
    "totalFileCount",
    "degradedFileCount",
    "omittedPaths",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string"
    },
    "indexedFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "totalFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "degradedFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "omittedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
