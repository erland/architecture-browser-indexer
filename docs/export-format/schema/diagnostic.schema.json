{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./diagnostic.schema.json",
  "title": "Diagnostic",
  "description": "Diagnostic object for architecture export. This schema mirrors the exported Diagnostic record.",
  "type": "object",
  "required": [
    "severity",
    "phase",
    "code",
    "message",
    "fatal",
    "filePath",
    "scopeId",
    "entityId",
    "sourceRefs",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "ACQUISITION",
        "SCAN",
        "EXTRACTION",
        "INTERPRETATION",
        "PUBLICATION"
      ]
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "fatal": {
      "type": "boolean"
    },
    "filePath": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/sourceReference"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Diagnostic metadata bag. Values are exporter-defined and intentionally extensible.",
      "default": {},
      "additionalProperties": true
    }
  }
}
