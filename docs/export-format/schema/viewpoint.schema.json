{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./viewpoint.schema.json",
  "title": "Architecture viewpoint descriptor",
  "description": "Document-level canonical viewpoint descriptor for architecture export.",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "availability",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "unavailable"
      ],
      "description": "Canonical viewpoint availability derived by the exporter."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "seedEntityIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "seedRoleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expandViaSemantics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preferredDependencyViews": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidenceSources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
