{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./relationship.schema.json",
  "title": "Relationship",
  "description": "Relationship object for architecture export.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "fromEntityId",
    "toEntityId",
    "label",
    "sourceRefs",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "DEPENDS_ON",
        "EXTENDS",
        "IMPLEMENTS",
        "EXPOSES",
        "CALLS",
        "READS",
        "WRITES",
        "CONTAINS",
        "USES"
      ],
      "description": "Relationship kind. Values must match the exported RelationshipKind enum."
    },
    "fromEntityId": {
      "type": "string"
    },
    "toEntityId": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/sourceReference"
      }
    },
    "metadata": {
      "$ref": "./common.schema.json#/$defs/stringMap",
      "description": "Extensible relationship metadata bag. Documented stable normalized keys may include associationKind, associationCardinality, sourceLowerBound, sourceUpperBound, targetLowerBound, and targetUpperBound. Framework-specific keys such as jpaAssociation remain allowed as evidence/provenance metadata."
    },
    "architecturalSemantics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
