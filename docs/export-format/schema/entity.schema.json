{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./entity.schema.json",
  "title": "Entity",
  "description": "Entity object for architecture export.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "origin",
    "name",
    "displayName",
    "scopeId",
    "sourceRefs",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "CLASS",
        "INTERFACE",
        "FUNCTION",
        "FIELD",
        "MODULE",
        "ENDPOINT",
        "SERVICE",
        "PERSISTENCE_ADAPTER",
        "UI_MODULE",
        "STARTUP_POINT",
        "DATASTORE",
        "EXTERNAL_SYSTEM",
        "CONFIG_ARTIFACT"
      ],
      "description": "Entity kind. Values must match the exported EntityKind enum."
    },
    "origin": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "INFERRED"
      ],
      "description": "Entity origin. Values must match the exported EntityOrigin enum."
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "scopeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/sourceReference"
      }
    },
    "metadata": {
      "$ref": "./common.schema.json#/$defs/stringMap"
    },
    "architecturalRoles": {
      "type": "array",
      "description": "Optional normalized architectural roles for the entity. Values are stable lowercase identifiers intended for viewpoint-friendly consumers.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "architecturalTraits": {
      "type": "array",
      "description": "Optional normalized architectural traits for the entity. Values are stable lowercase identifiers intended for viewpoint-friendly consumers.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
